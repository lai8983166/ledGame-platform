{
  "name": "ledgame-platform",
  "version": "0.1.0",
  "private": true,
  "description": "LED Game central membership platform",
  "scripts": {
    "dev": "concurrently -k \"pnpm dev:registration\" \"pnpm dev:member-admin\" \"mvn -f server/pom.xml spring-boot:run\"",
    "dev:registration": "pnpm --dir apps/registration-kiosk exec vite -- --host 127.0.0.1 --port 5176",
    "dev:member-admin": "pnpm --dir apps/member-admin exec vite -- --host 127.0.0.1 --port 5177",
    "build": "pnpm build:registration && pnpm build:member-admin",
    "build:registration": "pnpm --dir apps/registration-kiosk exec vite build",
    "build:member-admin": "pnpm --dir apps/member-admin exec vite build",
    "typecheck": "pnpm typecheck:registration && pnpm typecheck:member-admin && pnpm typecheck:packages",
    "typecheck:registration": "pnpm exec vue-tsc --noEmit -p apps/registration-kiosk/tsconfig.json",
    "typecheck:member-admin": "pnpm exec vue-tsc --noEmit -p apps/member-admin/tsconfig.json",
    "typecheck:packages": "pnpm exec tsc --noEmit -p packages/tsconfig.json",
    "test:client": "vitest run packages/api-client/src/index.test.ts apps/registration-kiosk/src/playerInfoFlow.test.ts",
    "test:server": "mvn -q -f server/pom.xml test",
    "test:core": "pnpm test:server && pnpm test:client",
    "test:e2e": "mvn -q -f server/pom.xml -Dtest=CoreFlowApiIntegrationTest#isolatedCoreSmokeRunsFromRegistrationThroughGameSettlementAndPlayerInfo test"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "concurrently": "^9.1.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.2.8"
  }
}
